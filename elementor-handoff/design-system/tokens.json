{
  "colors": {
    "blue": "#004fff",
    "yellow": "#ffff00",
    "cyan": "#00c7fc",
    "red": "#d12028",
    "green": "#00c112",
    "pink": "#e83a95",
    "orange": "#f05223",
    "black": "#000000",
    "white": "#ffffff"
  },
  "fonts": {
    "display": "Montserrat",
    "text": "Albert Sans"
  },
  "layout": {
    "desktopGutter": "clamp(20px, 2.1vw, 40px)",
    "mobileGutter": "20px",
    "breakpoint": "820px",
    "sectionPadding": "clamp(5rem, 9vw, 10rem)"
  },
  "motion": {
    "entryEase": "cubic-bezier(.16,1,.3,1)",
    "reducedMotion": true
  }
}
